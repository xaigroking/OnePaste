# Replace this placeholder with the HTTPS address and host port reachable from your desktops.
# Keep the public URL's port in sync with HOST_PORT below. This is not a hosted service.
ONEPASTE_PUBLIC_URL=https://YOUR_SERVER_PUBLIC_IP:8443

# Compose interpolation only; these two values are not passed to the server process.
HOST_PORT=8443
# Use a release tag to pin a version; edge is the newest automatic pre-release.
IMAGE=ghcr.io/xaigroking/onepaste-server:edge

# Production server setting: trace, debug, info, warn or error.
RUST_LOG=info
